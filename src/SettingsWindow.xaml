<Window x:Class="ControllerBattery.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:ControllerBattery.Behaviors"
        Title="Settings" Icon="/assets/controller-battery.ico" Width="460" Height="470" MinHeight="360" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#15141D" FontFamily="Segoe UI" WindowStyle="None"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleBarButton" TargetType="Button"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="45"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C8C4D3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C42B3A"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A52230"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Margin" Value="8,0,0,0"/></Style>
    <Style x:Key="PositionOption" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#CBC7D5"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="OptionBorder" Background="#191823" BorderBrush="#3B374B" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <ContentPresenter HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionBorder" Property="BorderBrush" Value="#70688F"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#302A50"/><Setter TargetName="OptionBorder" Property="BorderBrush" Value="#8B7CF6"/><Setter Property="Foreground" Value="#F4F2FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Margin" Value="8,2,0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Border Width="4" Background="#242230" CornerRadius="2" HorizontalAlignment="Center"/>
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="32">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" Width="6" Background="#625D78" CornerRadius="3" HorizontalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#8B7CF6"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#A99CF8"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="SettingsRoot" Opacity="0">
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#191823" BorderBrush="#2A2835" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="10,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/assets/controller-icon-titlebar.png" Width="42" Height="38" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Settings" Foreground="#F0EDF7" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><Button Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" Click="ChromeCloseButton_Click" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button></Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" PanningMode="VerticalOnly"
                  IsDeferredScrollingEnabled="False" behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Margin="28,28,0,0" Padding="0,0,18,0">
      <StackPanel>
        <TextBlock Text="Settings" Foreground="#F4F2FF" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Customize how Controller Battery behaves."
                   Foreground="#9995AA" Margin="0,5,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="OVERLAY" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold"
                   Margin="0,28,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="Quick-view shortcut" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Show or hide the battery overlay from anywhere in Windows."
                       Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Background="#191823" BorderBrush="#3B374B" BorderThickness="1"
                      CornerRadius="8" Padding="12,9">
                <TextBlock x:Name="ShortcutText" Foreground="#DCD8E8" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
              </Border>
              <Button x:Name="CaptureButton" Grid.Column="1" Content="Change"
                      Click="CaptureButton_Click" VerticalAlignment="Stretch"/>
            </Grid>
            <TextBlock Text="Press a modifier such as Ctrl, Alt, Shift, or Win together with another key."
                       Foreground="#777386" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="POSITION" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold"
                   Margin="0,24,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="Overlay location" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose which corner of the primary screen holds the overlay."
                       Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <UniformGrid Columns="2">
              <RadioButton x:Name="TopLeftPosition" Content="Top left" GroupName="OverlayPosition" Style="{StaticResource PositionOption}"/>
              <RadioButton x:Name="TopRightPosition" Content="Top right" GroupName="OverlayPosition" Style="{StaticResource PositionOption}" Margin="0,0,0,8"/>
              <RadioButton x:Name="BottomLeftPosition" Content="Bottom left" GroupName="OverlayPosition" Style="{StaticResource PositionOption}"/>
              <RadioButton x:Name="BottomRightPosition" Content="Bottom right" GroupName="OverlayPosition" Style="{StaticResource PositionOption}" Margin="0,0,0,8"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <TextBlock Text="REFRESH" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold"
                   Margin="0,24,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Controller polling" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose how often connected controllers and battery readings are refreshed."
                       Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <DockPanel LastChildFill="False">
              <TextBox x:Name="PollingIntervalText" Width="82"
                       Background="#191823" Foreground="#F4F2FF" BorderBrush="#514B68"
                       Padding="10,8" FontSize="14" TextAlignment="Center"/>
              <TextBlock Text="seconds" Foreground="#D1CDDB" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <TextBlock Text="5–300 allowed" Foreground="#777386" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Optional diagnostic block: safe to remove with TestLowBatteryButton_Click and its callback. -->
        <TextBlock Text="TEST" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold"
                   Margin="0,24,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Low-battery notification" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Preview the real alert and verify its placement. Controller data will not be changed."
                       Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <Button Content="Test low-battery notification" Click="TestLowBatteryButton_Click"
                    HorizontalAlignment="Left" Margin="0" Background="#3A304D"/>
          </StackPanel>
        </Border>

        <TextBlock Text="DIAGNOSTICS" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold" Margin="0,24,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Advanced controller capture" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Capture controller-class HID descriptors and short raw-report samples for protocol analysis. Keyboards and mice are excluded." Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <Button x:Name="CaptureDiagnosticsButton" Content="Capture controller diagnostics" Click="CaptureDiagnosticsButton_Click" HorizontalAlignment="Left" Margin="0"/>
            <TextBlock Text="The JSON contains device paths and serial numbers. Review it before sharing." Foreground="#C59063" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,16,28,28">
      <Button Content="Cancel" Click="CancelButton_Click"/>
      <Button Content="Save" Click="SaveButton_Click" Background="#6D5DD3"/>
    </StackPanel>
    <Border Grid.RowSpan="3" BorderBrush="#6C6482" BorderThickness="1"
            CornerRadius="11" IsHitTestVisible="False" Panel.ZIndex="100"/>
  </Grid>
</Window>
