<Window x:Class="ControllerBattery.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:ControllerBattery.Behaviors"
        Title="Controller profile" Icon="/assets/controller-battery.ico"
        Width="460" Height="470" MinHeight="360" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#15141D" FontFamily="Segoe UI"
        WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleBarButton" TargetType="Button"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="45"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C8C4D3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C42B3A"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A52230"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Margin" Value="8,0,0,0"/></Style>
    <Style x:Key="ColorOption" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="BorderBrush" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Width="38" Height="38" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="IconOption" TargetType="Button">
      <Setter Property="Width" Value="58"/><Setter Property="Height" Value="54"/><Setter Property="Foreground" Value="#CBC7D5"/><Setter Property="Background" Value="#191823"/><Setter Property="BorderBrush" Value="#3B374B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="OptionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionBorder" Property="BorderBrush" Value="#70688F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Opacity" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Margin" Value="8,2,0,2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Border Width="4" Background="#242230" CornerRadius="2" HorizontalAlignment="Center"/><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Width="6" Background="#625D78" CornerRadius="3" HorizontalAlignment="Center"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#8B7CF6"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#A99CF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="ProfileRoot" Opacity="0">
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#191823" BorderBrush="#2A2835" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="10,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/assets/controller-icon-titlebar.png" Width="42" Height="38" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Controller profile" Foreground="#F0EDF7" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><Button Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" Click="ChromeCloseButton_Click" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button></Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False" behaviors:SmoothScrollBehavior.IsEnabled="True" Margin="28,28,0,0" Padding="0,0,18,0">
      <StackPanel>
        <TextBlock Text="Controller profile" Foreground="#F4F2FF" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="DeviceDescription" Foreground="#9995AA" Margin="0,5,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="IDENTITY" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold" Margin="0,28,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="Custom name" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose the name shown throughout the dashboard and overlay." Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <TextBox x:Name="CustomNameTextBox" Padding="11,9" MaxLength="60" Background="#191823" Foreground="#F4F2FF" BorderBrush="#514B68" CaretBrush="#F4F2FF"/>
            <TextBlock Text="Leave blank to use the name reported by the controller." Foreground="#777386" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="APPEARANCE" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold" Margin="0,24,0,9"/>
        <Border Background="#22202D" CornerRadius="12" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Controller icon" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a controller family icon, or keep the automatically detected style." Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <WrapPanel x:Name="IconChoices" Margin="0,0,0,14"/>
            <Border Height="1" Background="#343140" Margin="0,0,0,16"/>
            <TextBlock Text="Profile color" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Use a color to recognize this controller in the dashboard and overlay." Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <WrapPanel x:Name="ColorChoices"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="LedOption" Visibility="Collapsed">
          <TextBlock Text="LED LIGHTING" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold" Margin="0,12,0,9"/>
          <Border Background="#22202D" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Controller LED" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Choose a separate color for the controller's built-in lighting." Foreground="#9995AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
              <CheckBox x:Name="CustomLedCheckBox" Foreground="#DCD8E8" VerticalContentAlignment="Center" Content="Set a custom controller LED color" Checked="CustomLedCheckBox_Changed" Unchecked="CustomLedCheckBox_Changed"/>
              <CheckBox x:Name="SyncLedWithProfileCheckBox" Foreground="#DCD8E8" VerticalContentAlignment="Center" Content="Sync with profile color" Margin="22,10,0,0" Checked="SyncLedWithProfileCheckBox_Changed" Unchecked="SyncLedWithProfileCheckBox_Changed"/>
              <Grid x:Name="LedColorControls" Margin="22,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="LedColorSwatch" Width="42" Height="42" CornerRadius="9" BorderBrush="#6C6482" BorderThickness="1" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="LED color" Foreground="#F4F2FF" FontWeight="SemiBold"/>
                  <TextBlock x:Name="LedColorValue" Foreground="#9995AA" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="LedColorButton" Grid.Column="2" Content="Change color" Click="LedColorButton_Click" Margin="12,0,0,0"/>
              </Grid>
              <StackPanel x:Name="LedBrightnessControls" Margin="22,18,0,0">
                <TextBlock Text="Brightness" Foreground="#F4F2FF" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="BrightLedBrightness" Content="Bright" GroupName="LedBrightness" Foreground="#DCD8E8" Checked="LedBrightness_Changed" Margin="0,0,22,0"/>
                  <RadioButton x:Name="MediumLedBrightness" Content="Medium" GroupName="LedBrightness" Foreground="#DCD8E8" Checked="LedBrightness_Changed" Margin="0,0,22,0"/>
                  <RadioButton x:Name="DimLedBrightness" Content="Dim" GroupName="LedBrightness" Foreground="#DCD8E8" Checked="LedBrightness_Changed"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,16,28,28">
      <Button Content="Cancel" Click="Cancel_Click"/>
      <Button Content="Save profile" Click="Save_Click" Background="#6D5DD3"/>
    </StackPanel>
    <Border Grid.RowSpan="3" BorderBrush="#6C6482" BorderThickness="1" CornerRadius="11" IsHitTestVisible="False" Panel.ZIndex="100"/>
  </Grid>
</Window>
