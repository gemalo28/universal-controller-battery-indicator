<Window x:Class="ControllerBattery.LedColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Choose LED color" Icon="/Assets/controller-battery.ico"
        Width="430" Height="505" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#15141D" FontFamily="Segoe UI" WindowStyle="None"
        PreviewMouseDown="Window_PreviewMouseDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="Slider">
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="255"/><Setter Property="TickFrequency" Value="1"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"><Setter Property="Margin" Value="8,0,0,0"/></Style>
    <Style x:Key="SuggestedColor" TargetType="Button">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,9,9"/><Setter Property="BorderBrush" Value="#6C6482"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="BorderBrush" Value="White"/><Setter TargetName="Swatch" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#191823" BorderBrush="#2A2835" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <TextBlock Text="Choose LED color" Foreground="#F0EDF7" FontSize="14" FontWeight="SemiBold" Margin="18,0" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="28,24">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
        <Border x:Name="ColorPreview" Width="76" Height="76" CornerRadius="16" BorderBrush="#6C6482" BorderThickness="1"/>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Live preview" Foreground="#F4F2FF" FontSize="17" FontWeight="SemiBold"/>
          <TextBox x:Name="HexInput" Text="#FFFFFF" Width="112" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,4"
                   Background="#191823" Foreground="#F4F2FF" BorderBrush="#514B68" CaretBrush="#F4F2FF"
                   MaxLength="7" ToolTip="Enter a color as #RRGGBB or #RGB"
                   KeyDown="HexInput_KeyDown" LostKeyboardFocus="HexInput_LostKeyboardFocus"/>
          <TextBlock Text="Changes appear on your controller while you adjust." Foreground="#777386" FontSize="11" Width="240" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Text="SUGGESTED COLORS" Foreground="#8B7CF6" FontSize="11" FontWeight="Bold" Margin="0,0,0,9"/>
      <WrapPanel x:Name="SuggestedColors" Margin="0,0,0,12"/>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Red" Foreground="#DCD8E8" VerticalAlignment="Center"/><Slider x:Name="RedSlider" Grid.Column="1" ValueChanged="ColorSlider_ValueChanged"/><TextBlock x:Name="RedValue" Grid.Column="2" Foreground="#9995AA" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Green" Foreground="#DCD8E8" VerticalAlignment="Center"/><Slider x:Name="GreenSlider" Grid.Column="1" ValueChanged="ColorSlider_ValueChanged"/><TextBlock x:Name="GreenValue" Grid.Column="2" Foreground="#9995AA" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Blue" Foreground="#DCD8E8" VerticalAlignment="Center"/><Slider x:Name="BlueSlider" Grid.Column="1" ValueChanged="ColorSlider_ValueChanged"/><TextBlock x:Name="BlueValue" Grid.Column="2" Foreground="#9995AA" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,16,28,28">
      <Button Content="Cancel" Click="Cancel_Click"/><Button Content="OK" Background="#6D5DD3" Click="Ok_Click"/>
    </StackPanel>
    <Border Grid.RowSpan="3" BorderBrush="#6C6482" BorderThickness="1" CornerRadius="11" IsHitTestVisible="False"/>
  </Grid>
</Window>
