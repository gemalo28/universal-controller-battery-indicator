<Window x:Class="ControllerBattery.ControllerConnectionNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="370" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" ResizeMode="NoResize" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Background="#F415141D" BorderBrush="#4B465C" BorderThickness="1"
          CornerRadius="16" Padding="18">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="IconSurface" Width="48" Height="48" CornerRadius="14"
              Background="#29263A" VerticalAlignment="Top">
        <ContentControl x:Name="ControllerIcon" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,12,0">
        <TextBlock x:Name="TitleText" Foreground="#F4F2FF" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="MessageText" Foreground="#AAA5B5" FontSize="13" LineHeight="19"
                   TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="2" Content="×" Click="CloseButton_Click" Width="28" Height="28"
              Padding="0" Foreground="#A9A4B3" Background="Transparent" BorderThickness="0"
              FontSize="17" Cursor="Hand" VerticalAlignment="Top"/>
    </Grid>
  </Border>
</Window>
