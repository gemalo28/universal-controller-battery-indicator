<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControllerBattery</RootNamespace>
    <AssemblyName>ControllerBattery</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\controller-battery.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\controller-battery.ico" />
    <Resource Include="Assets\controller-icon-titlebar.png" />
    <None Update="Assets\controller-icon-source.png" CopyToOutputDirectory="Never" />
    <None Update="Assets\controller-icon.png" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
