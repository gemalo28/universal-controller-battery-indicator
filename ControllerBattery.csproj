<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControllerBattery</RootNamespace>
    <AssemblyName>ControllerBattery</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>assets\controller-battery.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="assets\controller-battery.ico" />
    <Resource Include="assets\controller-icon-titlebar.png" />
  </ItemGroup>
</Project>
